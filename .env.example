# Supabase project address and browser-safe key (auth only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres, pooled connection (port 6543), used by the app
DATABASE_URL=
# Postgres, direct connection (port 5432), used for migrations
DIRECT_URL=
# Claude API key for Ask the Cellar
ANTHROPIC_API_KEY=
# Shared secret the refresh route expects in the x-ingest-secret header
INGEST_SECRET=
# Gmail account and app password that send the alert email
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
# Public address of the app, used in email links
APP_URL=
